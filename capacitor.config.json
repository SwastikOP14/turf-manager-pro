{
  "appId": "com.turfmanager.pro",
  "appName": "Turf Manager Pro",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "App": {
      "hardwareBackButton": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    },
    "EdgeToEdge": {
      "enabled": true
    }
  }
}
