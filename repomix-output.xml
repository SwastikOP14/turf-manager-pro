                </p>
                <p className={`text-[20px] font-bold mt-0.5 m-0 ${squadBalance >= 0 ? "text-green-700 dark:text-green-400" : "text-red-600 dark:text-red-500"}`}>
                  {squadBalance >= 0 ? "↑" : "↓"} {formatCurrency(Math.abs(squadBalance))}
                </p>
