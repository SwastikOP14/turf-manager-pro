          team.playerIds?.some((pid) => memberIds.includes(pid))
        );
      })
      .sort((a, b) => new Date(b.date) - new Date(a.date));
  }, [bookings, memberIds]);

  // Payment History should only show real player top-ups, not booking deductions
  const paymentHistory = useMemo(() => {
