        return { ...c, playerName: player?.name || "Unknown" };
      })
      .sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
  }, [squad.contributions, getPlayerById]);

  const handleDelete = () => {
    haptics.trigger([15, 50, 15]);
    deleteSquad(squad.id);
    navigate("/players");
  };

