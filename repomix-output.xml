              ) : (
                <span style={{ fontSize: "16px", fontWeight: 800, color: "#000" }}>
                  {getInitials(squad.name)}
                </span>
              )}
            </div>
            <div>
              <h1 className="text-[17px] font-bold text-slate-900 dark:text-white m-0">
                {squad.name}
