                        <p className="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                          {turf?.name || "—"} • {formatDisplayDate(booking.date)}
                        </p>
                        {squadName && (
                          <p className="text-xs font-semibold mt-1" style={{ color: "var(--brand)" }}>
                            🏟 {squadName}
                          </p>
